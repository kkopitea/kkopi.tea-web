rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isActiveAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && (
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
          || (
            !('active' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data)
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true
          )
        );
    }

    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read, write: if isActiveAdmin();
    }

    match /products/{productId} {
      allow read, write: if isActiveAdmin();
    }

    match /inventory/{itemId} {
      allow read, write: if isActiveAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isActiveAdmin();
    }
  }
}
